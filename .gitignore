# 依赖
node_modules/

# 多文件构建产物（可由 npm run build 重新生成）
dist/

# esbuild / 调试用的临时目录
.build/
.tmp/

# 笔画源数据（32MB，可由 README 里的 npm pack + tar 重新解出）
.vendor/
*.tgz

# 日志
*.log

# 中文字体构建的中间分片（可由 python scripts/build-cjk.py 重新拉取，5.9MB，不入库）
src/assets/cjk/shards/

# 系统
.DS_Store
Thumbs.db

# 说明：dist-single/签名生成器.html 与示例导出 MP4 是交付产物，故意纳入版本管理。
